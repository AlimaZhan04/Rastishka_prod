        <mxCell id="text-20" value="Предел WAF 12 МиБ, Next.js 11 МиБ.&#10;Файл резюме до 10 МиБ проверяется приложением." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=18;fontStyle=0;fontColor=#454545;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="body" connectable="0">
