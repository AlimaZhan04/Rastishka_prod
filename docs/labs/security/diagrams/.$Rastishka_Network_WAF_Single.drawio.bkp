          <mxGeometry x="14" y="9" width="647" height="30" as="geometry" />
        </mxCell>
        <mxCell id="text-96" value="WAF сохраняет Host и заменяет forwarded-заголовки.&#10;Полный аудит HTTP выключен в профиле стенда." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=18;fontStyle=0;fontColor=#454545;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="local-headers" connectable="0">
          <mxGeometry x="14" y="42" width="647" height="66" as="geometry" />
        </mxCell>
        <mxCell id="text-97" value="Проверка стенда · infra/waf/smoke.ps1 ожидает 200 для сайта и входа и 403 для тестов XSS и SQL-инъекции." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=17;fontStyle=0;fontColor=#454545;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="1" connectable="0">
          <mxGeometry x="78" y="1723" width="2143" height="30" as="geometry" />
