# Пример переменных окружения. Скопировать в .env и заполнить реальными значениями.
# В Vercel задаются отдельно для Preview и Production (каждое — свой Supabase-проект).

# Метка среды только для серверной диагностики. Не содержит секретов.
APP_ENV="development"

# --- Database (Prisma / Postgres) ---
# DATABASE_URL — pooled-подключение (Supabase PgBouncer, порт 6543, ?pgbouncer=true) для рантайма.
# DIRECT_URL  — прямое подключение (порт 5432) для миграций.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"
# Только для локального `prisma migrate dev` или изолированного контура генерации миграций.
# Никогда не указывайте здесь рабочую staging/production-схему.
SHADOW_DATABASE_URL=""

# --- Site ---
NEXT_PUBLIC_SITE_URL="https://ras-tishka.kg"
ADMIN_BASE_URL="https://ras-tishka.kg/admin"

# --- Auth.js / NextAuth ---
# NEXTAUTH_SECRET: сгенерировать `openssl rand -base64 32`
NEXTAUTH_SECRET=""
NEXTAUTH_URL="https://ras-tishka.kg"

# --- Seed (начальный администратор; только для первичного наполнения) ---
SEED_ADMIN_LOGIN="admin"
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME="Администратор"
# Необязательная учётная запись контент-менеджера: укажите оба значения либо оставьте оба пустыми.
SEED_CONTENT_MANAGER_LOGIN=""
SEED_CONTENT_MANAGER_PASSWORD=""
SEED_CONTENT_MANAGER_NAME="Контент-менеджер"

# --- Supabase Storage (приватный bucket резюме, public-read для изображений) ---
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# --- Notifications ---
# Telegram — основной канал MVP.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
# E-mail (Resend) — резервный канал надёжности.
RESEND_API_KEY=""
NOTIFY_EMAIL_FROM="no-reply@ras-tishka.kg"
# WhatsApp Business API — подключается по готовности бизнес-аккаунта.
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_ID=""
